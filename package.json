{
  "name": "mersal-info-center",
  "version": "3.0.0",
  "description": "مركز معلومات مرسال — Mersal Foundation Information Center",
  "author": "Nada Naser <nadanaser168@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win"
  },
  "build": {
    "appId": "org.mersal.infocenter",
    "productName": "Mersal Info Center",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "src/assets/logo.webp",
      "category": "Office"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "src/assets/logo.webp"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
